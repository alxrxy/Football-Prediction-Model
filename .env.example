# Copy to .env and fill in. Never commit the real .env.

CFBD_API_KEY=
ODDS_API_KEY=

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=

STORAGE_BACKEND=sqlite
SQLITE_PATH=data/football.db

ODDS_CACHE_MINUTES=180
# Optional: named Odds API books instead of the "us" region, e.g. to add
# pinnacle as the sharp anchor. Up to 10 books cost the same as one region.
ODDS_BOOKMAKERS=
# Points gap, now used only in report sensitivity tables (not for flags).
VALUE_EDGE_THRESHOLD=2.0

# Stage 1 edge logic (src/market.py): model weight in the log-odds blend with
# the devigged market, margin over break-even a flag needs, devig method.
MODEL_MARKET_WEIGHT=0.15
EDGE_BUFFER=0.03
DEVIG_METHOD=shin

# P13 (src/qb_prior.py): NFL prior-season offense from the expected starting
# QB's games. Retrain the NFL model whenever this changes.
QB_CONDITIONAL_PRIOR=0

# A nullified penalty replays the down instead of consuming one
# (src/simulate.py). Real replays 69.8% of them; the engine consumes 71.7%,
# which shortens every drive. Turning this on changes simulated output, so
# re-run simulate_nfl and re-rank props afterwards or they go stale.
PENALTY_REPLAY=0

# Shift each prop category's simulated probability by its measured bias
# (src/props.py BIAS_FIT). Display only -- the simulation engine and the
# game-level predictions are untouched. A stopgap over an unfixed root cause,
# fitted in sample on one week with 25-69 props per category.
PROPS_BIAS_ADJUST=0

# Claude API: dashboard Q&A and prop explanations (src/claude_ai.py).
Claude_API_KEY=
CLAUDE_API_MODEL=claude-opus-5
CLAUDE_API_EFFORT=low
CLAUDE_DAILY_BUDGET_USD=2.0
# Player-prop markets pulled by src/ingest_props.py (1 credit per market per game).
PROP_MARKETS=player_pass_yds,player_rush_yds,player_reception_yds,player_receptions
